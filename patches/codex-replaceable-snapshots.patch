+#[test]
+fn projection_preserves_evidence_identity_and_other_keys() {
+    let a = snapshot("map", "old terrain");
+    let b = snapshot("map", "new terrain");
+    let other = snapshot("other", "independent session");
+    let items = vec![
+        output(&format!("Hit for 9!\n{a}\n{other}\nDecision pending")),
+        output(&b),
+    ];
+    let expected = vec![
+        output(&format!(
+            "Hit for 9!\n[Snapshot map superseded.]\n{other}\nDecision pending"
+        )),
+        output(&b),
+    ];
+    assert_eq!(project(items.clone(), &["map".into()]), expected);
+    assert_eq!(project(expected.clone(), &["map".into()]), expected);
+    assert_eq!(project(items.clone(), &[]), items);
+    assert_eq!(project(items.clone(), &["unmatched".into()]), items);
+}
+
+#[test]
+fn prefix_patterns_preserve_full_key_identity_and_nonmatching_outputs() {
+    let keys = ["crawl/a/map", "crawl/b/map", "crawl/map", "crawler/map", "other"];
+    let old: Vec<_> = keys.iter().map(|key| output(&snapshot(key, "old"))).collect();
+    let latest: Vec<_> = keys.iter().map(|key| output(&snapshot(key, "new"))).collect();
+    let mut items = old.clone();
+    items.extend(latest.clone());
+    for (patterns, replaced) in [
+        (vec!["crawl/*"], vec![0, 1, 2]),
+        (vec!["crawl/a/*", "crawl/a/map", "other"], vec![0, 4]),
+        (vec!["*"], vec![0, 1, 2, 3, 4]),
+        (vec!["crawl/", "crawl/*/map", "crawl/**", "^crawl/.*$"], vec![]),
+    ] {
+        let mut expected = old.clone();
+        for index in replaced {
+            expected[index] = output(&format!("[Snapshot {} superseded.]", keys[index]));
+        }
+        expected.extend(latest.clone());
+        let allowed: Vec<_> = patterns.into_iter().map(str::to_owned).collect();
+        assert_eq!(project(items.clone(), &allowed), expected);
+        assert_eq!(project(expected.clone(), &allowed), expected);
+    }
+}
