+#[test]
+fn projection_and_accounting_follow_surviving_history() {
+    let a = snapshot("map", &"terrain".repeat(/*n*/ 200));
+    let b = snapshot("map", "new");
+    let mut history = ContextManager::new();
+    history.replaceable_tool_output_keys = vec!["map".into()];
+    history.replace_annotated(vec![output(&a), output(&b)]);
+    let original = history.annotated_items().to_vec();
+    let expected = project(original.clone(), &["map".into()]);
+    assert_eq!(history.clone().for_prompt_annotated(&[]), expected);
+    assert_eq!(history.annotated_items(), original);
+    let instructions = BaseInstructions {
+        text: String::new(),
+        provenance: None,
+    };
+    assert_eq!(
+        history.estimate_token_count_with_base_instructions(&instructions),
+        Some(
+            expected
+                .iter()
+                .map(|entry| super::super::estimate_item_token_count(&entry.item))
+                .sum()
+        )
+    );
+    history.replace_annotated(vec![output(&a)]);
+    assert_eq!(history.clone().for_prompt_annotated(&[]), vec![output(&a)]);
+    // A user-authored marker never participates in tool-output replacement.
+    let message = ResponseItemEnvelope::new(
+        serde_json::from_value(json!({
+            "type":"message", "role":"user", "content":[{"type":"input_text", "text": b}],
+            "internal_chat_message_metadata_passthrough":{"content_item_kinds":["unknown"]}
+        }))
+        .unwrap(),
+    );
+    history.replace_annotated(vec![output(&a), message.clone()]);
+    assert_eq!(
+        history.clone().for_prompt_annotated(&[]),
+        vec![output(&a), message]
+    );
+}
+
+#[test]
+fn rollback_restores_latest_surviving_map_and_accounts_for_replacement() {
+    let message =
+        |role: &str| {
+            ResponseItemEnvelope::new(serde_json::from_value(json!({
+        "type":"message", "role":role, "content":[{"type":"input_text", "text":"observe"}],
+        "internal_chat_message_metadata_passthrough":{"content_item_kinds":["unknown"]}
+    })).unwrap())
+        };
+    let a = snapshot("map", &"terrain".repeat(/*n*/ 500));
+    let b = snapshot("map", "new");
+    let mut history = ContextManager::new();
+    history.replaceable_tool_output_keys = vec!["map".into()];
+    let previous = vec![message("user"), output(&a), message("assistant")];
+    let mut full = previous.clone();
+    full.extend([message("user"), message("assistant"), output(&b)]);
+    history.replace_annotated(full.clone());
+    let projected = project(full.clone(), &["map".into()]);
+    let tokens = |items: &[ResponseItemEnvelope]| {
+        items
+            .iter()
+            .map(|entry| super::super::estimate_item_token_count(&entry.item))
+            .sum::<i64>()
+    };
+    assert_eq!(
+        history.estimated_tokens_after_last_model_generated_item(),
+        tokens(&projected) - tokens(&full[..full.len() - 1])
+    );
+    assert!(tokens(&projected) < tokens(&full) / 4);
+    history.drop_last_n_user_turns(/*num_turns*/ 1);
+    assert_eq!(history.clone().for_prompt_annotated(&[]), previous);
+    // Rehydration from saved response items carries raw bodies; projection is recomputed.
+    let serialized = serde_json::to_string(&history.raw_items().collect::<Vec<_>>()).unwrap();
+    let mut resumed = ContextManager::new();
+    resumed.replaceable_tool_output_keys = vec!["map".into()];
+    resumed.replace(serde_json::from_str(&serialized).unwrap());
+    assert_eq!(resumed.for_prompt_annotated(&[]), previous);
+}
