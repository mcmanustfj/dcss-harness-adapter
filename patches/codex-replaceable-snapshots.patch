+#[test]
+fn exact_byte_key_and_count_limits_are_accepted() {
+    let key = "k".repeat(/*n*/ 128);
+    let overhead = snapshot(&key, "").len();
+    let block = snapshot(&key, &"x".repeat(MAX_BLOCK_BYTES - overhead));
+    assert_eq!(
+        blocks(&block),
+        Some(vec![(0..MAX_BLOCK_BYTES, key.as_str())])
+    );
+    assert_eq!(
+        blocks(&snapshot(&key, &"x".repeat(MAX_BLOCK_BYTES - overhead + 1))),
+        None
+    );
+    let text = (0..MAX_BLOCKS)
+        .map(|_| format!("{}\n", snapshot("map", "x")))
+        .collect::<String>();
+    assert_eq!(blocks(&text).unwrap().len(), MAX_BLOCKS);
+}
