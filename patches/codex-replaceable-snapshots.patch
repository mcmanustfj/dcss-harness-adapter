+#[test]
+fn invalid_results_cannot_supersede_complete_observations() {
+    let valid = snapshot("map", "terrain");
+    let invalid = [
+        snapshot("map", ""),
+        snapshot("", "terrain"),
+        snapshot(&"m".repeat(/*n*/ 129), "terrain"),
+        snapshot("map", &"x".repeat(MAX_BLOCK_BYTES)),
+        snapshot("map", &snapshot("map", "nested")),
+        "<codex_snapshot key=\"map\">\nincomplete".into(),
+        snapshot("map", "head…100 tokens truncated…tail"),
+        format!("Warning: truncated output\n{valid}"),
+        format!("<codex_snapshot key='map'>\n{valid}\n</codex_snapshot>"),
+        format!("prefix{valid}"),
+        valid.replace("key=\"map\"", "key=\"map space\""),
+        (0..=MAX_BLOCKS).map(|_| format!("{valid}\n")).collect(),
+        serde_json::to_string(&valid).unwrap(),
+    ];
+    for text in invalid {
+        assert!(blocks(&text).is_none_or(|parsed| parsed.is_empty()));
+        let items = vec![output(&valid), output(&text)];
+        assert_eq!(project(items.clone(), &["map".into()]), items, "{text}");
+    }
+}
