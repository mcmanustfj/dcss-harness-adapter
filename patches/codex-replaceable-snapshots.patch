+#[test]
+fn result_limits_and_truncation_apply_across_text_parts() {
+    let valid = snapshot("map", "terrain");
+    let mut many: Vec<_> = (0..MAX_BLOCKS).map(|_| valid.clone()).collect();
+    many.push(valid.clone());
+    for parts in [
+        many,
+        vec!["Warning: truncated output".into(), valid.clone()],
+    ] {
+        let item = ResponseItemEnvelope::new(
+            serde_json::from_value(json!({
+                "type":"custom_tool_call_output", "call_id":"call", "output":parts.iter()
