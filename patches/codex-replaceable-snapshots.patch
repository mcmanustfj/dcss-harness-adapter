--- /dev/null
+++ b/codex-rs/core/src/context_manager/snapshots.rs
@@ -0,0 +1,175 @@
+//! Opt-in model projection, never a rewrite of transcript or authorization evidence.
+//! Delimiters occupy entire LF/CRLF-delimited lines. Bodies are opaque complete snapshots;
+//! JSON strings (including escaped delimiters) are not recursively inspected.
+//! Compaction may discard even the latest snapshot: controllers must obtain a full observation.
+
+use super::ContextManager;
+use super::estimate_item_token_count;
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::models::FunctionCallOutputBody;
+use codex_protocol::models::FunctionCallOutputContentItem;
+use codex_protocol::models::ResponseItem;
+use std::borrow::Cow;
+use std::collections::HashSet;
+use std::ops::Range;
+
+impl ContextManager {
+    pub(crate) fn projected_items(&self) -> Cow<'_, [ResponseItemEnvelope]> {
+        if self.replaceable_tool_output_keys.is_empty() {
+            Cow::Borrowed(&self.items)
+        } else {
+            Cow::Owned(project(
+                self.items.as_ref().clone(),
+                &self.replaceable_tool_output_keys,
+            ))
+        }
+    }
+
+    pub(crate) fn estimated_tokens_after_last_model_generated_item(&self) -> i64 {
+        if self.replaceable_tool_output_keys.is_empty() {
+            return self
+                .items_after_last_model_generated_item()
+                .map(estimate_item_token_count)
+                .fold(/*init*/ 0i64, i64::saturating_add);
+        }
+        let start = self.items.len() - self.items_after_last_model_generated_item().len();
+        let prefix = project(
+            self.items[..start].to_vec(),
+            &self.replaceable_tool_output_keys,
+        );
+        let tokens = |items: &[ResponseItemEnvelope]| {
+            items
+                .iter()
+                .map(|entry| estimate_item_token_count(&entry.item))
+                .fold(/*init*/ 0i64, i64::saturating_add)
+        };
+        // Newly observed snapshots can also shrink already-accounted-for output.
+        tokens(&self.projected_items()).saturating_sub(tokens(&prefix))
+    }
+}
+
+const OPEN: &str = "<codex_snapshot key=\"";
+const CLOSE: &str = "</codex_snapshot>";
+const MAX_BLOCK_BYTES: usize = 8192;
+const MAX_BLOCKS: usize = 32;
+
+fn blocks(text: &str) -> Option<Vec<(Range<usize>, &str)>> {
+    // Middle truncation can leave both delimiters intact. Reject its markers even
+    // outside a block so a truncated result cannot manufacture a replacement.
+    if text.contains("Warning: truncated output")
+        || text.contains(" tokens truncated…")
+        || text.contains(" chars truncated…")
+        || text.contains("[omitted ")
+    {
+        return None;
+    }
+    let mut result = Vec::new();
+    let mut pending = None;
+    let mut offset = 0;
+    for line in text.split_inclusive('\n') {
+        let value = line.strip_suffix('\n').unwrap_or(line);
+        let value = value.strip_suffix('\r').unwrap_or(value);
+        if value.starts_with("<codex_snapshot") {
+            // Fail closed for this result, including malformed/nested openers.
+            if pending.is_some() {
+                return None;
+            }
+            let key = value
+                .strip_prefix(OPEN)
+                .and_then(|s| s.strip_suffix("\">"))?;
+            if key.is_empty()
+                || key.len() > 128
+                || !key.bytes().all(|b| {
+                    b.is_ascii_alphanumeric() || matches!(b, b'/' | b'_' | b'-' | b'.' | b':')
+                })
+            {
+                return None;
+            }
+            pending = Some((offset, offset + line.len(), key));
+        } else if value == CLOSE {
+            let (start, body_start, key) = pending.take()?;
+            let end = offset + value.len();
+            if end - start > MAX_BLOCK_BYTES
+                || result.len() == MAX_BLOCKS
+                || text[body_start..offset].trim().is_empty()
+            {
+                return None;
+            }
+            result.push((start..end, key));
+        }
+        offset += line.len();
+    }
+    pending.is_none().then_some(result)
+}
+
+pub(super) fn project(
+    mut items: Vec<ResponseItemEnvelope>,
+    allowed: &[String],
+) -> Vec<ResponseItemEnvelope> {
+    if allowed.is_empty() {
+        return items;
+    }
+    let mut seen = HashSet::new();
+    for envelope in items.iter_mut().rev() {
+        let output = match &mut envelope.item {
+            ResponseItem::FunctionCallOutput { output, .. }
+            | ResponseItem::CustomToolCallOutput { output, .. } => output,
+            _ => continue,
+        };
+        let mut texts = match &mut output.body {
+            FunctionCallOutputBody::Text(text) => vec![text],
+            FunctionCallOutputBody::ContentItems(parts) => parts
+                .iter_mut()
+                .filter_map(|part| match part {
+                    FunctionCallOutputContentItem::InputText { text } => Some(text),
+                    FunctionCallOutputContentItem::InputImage { .. }
+                    | FunctionCallOutputContentItem::InputAudio { .. }
+                    | FunctionCallOutputContentItem::EncryptedContent { .. } => None,
+                })
+                .collect(),
+        };
+        // Blocks cannot straddle parts; the count limit applies to the whole result.
+        let Some(parsed) = texts
+            .iter()
+            .map(|text| blocks(text))
+            .collect::<Option<Vec<_>>>()
+        else {
+            continue;
+        };
+        if parsed.iter().map(Vec::len).sum::<usize>() > MAX_BLOCKS {
+            continue;
+        }
+        let replacements: Vec<Vec<_>> = parsed
+            .into_iter()
+            .rev()
+            .map(|blocks| {
+                blocks
+                    .into_iter()
+                    .rev()
+                    .filter_map(|(range, key)| {
+                        let eligible = allowed.iter().any(|pattern| {
+                            pattern
+                                .strip_suffix('*')
+                                .map_or(pattern == key, |prefix| key.starts_with(prefix))
+                        });
+                        if eligible && !seen.insert(key.to_owned()) {
+                            Some((range, format!("[Snapshot {key} superseded.]")))
+                        } else {
+                            None
+                        }
+                    })
+                    .collect()
+            })
+            .collect();
+        for (text, replacements) in texts.iter_mut().rev().zip(replacements) {
+            for (range, replacement) in replacements {
+                text.replace_range(range, &replacement);
+            }
+        }
+    }
+    items
+}
