@@ -0,0 +1,206 @@
+use anyhow::Result;
+use codex_features::Feature;
+use codex_history::RolloutItem;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::Op;
+use codex_protocol::protocol::ThreadRolledBackEvent;
+use core_test_support::responses;
+use core_test_support::skip_if_no_network;
+use core_test_support::test_codex::TestCodexHarness;
+use core_test_support::test_codex::test_codex;
+use core_test_support::wait_for_event;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use test_case::test_case;
+
+#[test_case(false, "crawl/test/map"; "shell")]
+#[test_case(true, "crawl/test/map"; "code_mode")]
+#[test_case(false, ""; "disabled")]
+#[test_case(false, "crawl/*"; "shell_prefix")]
+#[test_case(true, "crawl/*"; "code_mode_prefix")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn snapshots_project_requests_but_preserve_review_and_rollout(
+    code_mode: bool,
+    pattern: &'static str,
+) -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let enabled = !pattern.is_empty();
+    let harness = TestCodexHarness::with_auto_env_builder(
+        test_codex()
+            .with_model("test-gpt-5.1-codex")
+            .with_config(move |config| {
+                if enabled {
+                    config.experimental_replaceable_tool_output_keys =
+                        vec![pattern.into()];
+                }
+                if code_mode {
+                    let _ = config.features.enable(Feature::CodeMode);
+                    let _ = config.features.enable(Feature::ExecutedToolCallMetadata);
+                } else {
+                    let _ = config.features.disable(Feature::CodeMode);
+                }
+            }),
+    )
+    .await?;
+    let server = harness.server();
+    let test = harness.test();
+    let mut outputs: Vec<serde_json::Value> = Vec::new();
+    for sequence in 0..3 {
+        let mut body = format!(
+            "Combat message {sequence}\n<codex_snapshot key=\"crawl/test/map\">\n{{\"map\":\"terrain-{sequence}\"}}\n</codex_snapshot>\nDecision required\n"
+        );
+        if sequence == 0 {
+            body.push_str("<codex_snapshot key=\"crawl/other/map\">\nIndependent map\n</codex_snapshot>\n");
+        }
+        harness.write_file("map.txt", &body).await?;
+        let call_id = format!("call-{sequence}");
+        let call = if code_mode {
+            responses::ev_custom_tool_call(
+                &call_id,
+                "exec",
+                "text((await tools.exec_command({cmd: 'cat map.txt'})).output)",
+            )
+        } else {
+            responses::ev_exec_command_call(&call_id, "cat map.txt")
+        };
+        responses::mount_sse_once(
+            server,
+            responses::sse(vec![
+                responses::ev_response_created(&format!("tool-{sequence}")),
+                call,
+                responses::ev_completed(&format!("tool-{sequence}")),
+            ]),
+        )
+        .await;
+        let mock = responses::mount_sse_once(
+            server,
+            responses::sse(vec![
+                responses::ev_assistant_message(&format!("msg-{sequence}"), "Observed"),
+                responses::ev_completed(&format!("done-{sequence}")),
+            ]),
+        )
+        .await;
+        test.submit_turn("Read the map file").await?;
+        let request = mock.single_request();
+        assert_eq!(
+            request
+                .inputs_of_type(if code_mode {
+                    "custom_tool_call"
+                } else {
+                    "function_call"
+                })
+                .len(),
+            sequence + 1
+        );
+        let get_output = |id: &str| {
+            if code_mode {
+                request.custom_tool_call_output(id)
+            } else {
+                request.function_call_output(id)
+            }
+        };
+        let current = get_output(&call_id);
+        assert!(current.to_string().contains(&format!("terrain-{sequence}")));
+        for (old_sequence, original) in outputs.iter().enumerate() {
+            if !enabled {
+                assert_eq!(get_output(&format!("call-{old_sequence}")), *original);
+                continue;
+            }
+            let mut expected: serde_json::Value = original.clone();
+            let old_block = format!(
+                "<codex_snapshot key=\"crawl/test/map\">\n{{\"map\":\"terrain-{old_sequence}\"}}\n</codex_snapshot>"
+            );
+            let placeholder = "[Snapshot crawl/test/map superseded.]";
+            match &mut expected["output"] {
+                serde_json::Value::String(text) => {
+                    *text = text
+                        .replace(&old_block, placeholder)
+                        .replace(&old_block.replace('\n', "\r\n"), placeholder)
+                }
+                serde_json::Value::Array(parts) => {
+                    for part in parts {
+                        if let Some(text) = part["text"].as_str() {
+                            part["text"] = json!(
+                                text.replace(&old_block, placeholder)
+                                    .replace(&old_block.replace('\n', "\r\n"), placeholder)
+                            );
+                        }
+                    }
+                }
+                other => panic!("unexpected output: {other}"),
+            }
+            assert_eq!(get_output(&format!("call-{old_sequence}")), expected);
+            // In particular, attempted-tool metadata must not duplicate the old map.
+            assert!(
+                !serde_json::to_string(&request.input())?
+                    .contains(&format!("terrain-{old_sequence}"))
+            );
+        }
+        outputs.push(current);
+    }
+    let review = test.codex.conversation_history_snapshot().await;
+    let evidence = serde_json::to_string(&review.review_items().collect::<Vec<_>>())?;
+    for sequence in 0..3 {
+        assert!(evidence.contains(&format!("terrain-{sequence}")));
+    }
+    test.codex
+        .append_rollout_items(&[RolloutItem::EventMsg(EventMsg::ThreadRolledBack(
+            ThreadRolledBackEvent { num_turns: 1 },
+        ))])
+        .await?;
+    let features = test.config.features.clone();
+    let resumed = test_codex()
+        .with_model("test-gpt-5.1-codex")
+        .with_config(move |config| {
+            if enabled {
+                config.experimental_replaceable_tool_output_keys = vec![pattern.into()];
+            }
+            config.features = features;
+        })
+        .restart(server, test)
+        .await?;
+    let test = &resumed;
+    let replay = responses::mount_sse_once(
+        server,
+        responses::sse(vec![
+            responses::ev_assistant_message("resumed", "Continue"),
+            responses::ev_completed("resumed"),
+        ]),
+    )
+    .await;
+    test.submit_turn("Continue from the saved map").await?;
+    let replay_input = serde_json::to_string(&replay.single_request().input())?;
+    assert_eq!(replay_input.contains("terrain-0"), !enabled);
+    assert!(replay_input.contains("terrain-1"));
+    assert!(!replay_input.contains("terrain-2"));
+    let compact = responses::mount_sse_once(
+        server,
+        responses::sse(vec![
+            json!({"type":"response.output_item.done", "item":{
+                "type":"compaction", "encrypted_content":"summary"
+            }}),
+            responses::ev_completed("compacted"),
+        ]),
+    )
+    .await;
+    test.codex.submit(Op::Compact).await?;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    let compact_input = serde_json::to_string(&compact.single_request().input())?;
+    assert_eq!(compact_input.contains("terrain-0"), !enabled);
+    assert!(compact_input.contains("terrain-1"));
+    assert!(!compact_input.contains("terrain-2"));
+    test.codex.shutdown_and_wait().await?;
+    let rollout = std::fs::read_to_string(
+        test.session_configured
+            .rollout_path
+            .as_ref()
+            .expect("persisted rollout"),
+    )?;
+    for sequence in 0..3 {
+        assert!(rollout.contains(&format!("terrain-{sequence}")));
+    }
+    Ok(())
+}
