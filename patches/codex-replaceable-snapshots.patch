+#[test]
+fn content_parts_clear_and_omitted_updates_preserve_surroundings() {
+    let a = snapshot("map", "terrain");
+    let clear = snapshot("map", r#"{"map":null,"label":"</codex_snapshot>"}"#);
+    let item = ResponseItemEnvelope::new(
