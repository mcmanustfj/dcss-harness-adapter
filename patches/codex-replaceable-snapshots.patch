+use super::*;
+use pretty_assertions::assert_eq;
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn superseded_snapshot_forces_full_request_then_reuses_stable_projection() {
+    skip_if_no_network!();
+    let server = start_websocket_server(vec![vec![
+        vec![ev_response_created("resp-1"), ev_completed("resp-1")],
+        vec![ev_response_created("resp-2"), ev_completed("resp-2")],
+        vec![ev_response_created("resp-3"), ev_completed("resp-3")],
+    ]])
+    .await;
+    let harness = websocket_harness(&server).await;
+    let mut session = harness.client.new_session();
+    let output = |text: &str| {
+        serde_json::from_value(json!({
+            "type":"function_call_output", "name":"map", "output":text
+        }))
+        .unwrap()
+    };
+    let original = prompt_with_input(vec![output(
+        "<codex_snapshot key=\"map\">\nold terrain\n</codex_snapshot>",
+    )]);
+    let projected = prompt_with_input(vec![
+        output("[Snapshot map superseded.]"),
+        output("<codex_snapshot key=\"map\">\nnew terrain\n</codex_snapshot>"),
+    ]);
+    stream_until_complete(&mut session, &harness, &original).await;
+    stream_until_complete(&mut session, &harness, &projected).await;
+    stream_until_complete(&mut session, &harness, &projected).await;
+    let connection = server.single_connection();
+    let full = connection.get(/*index*/ 1).unwrap().body_json();
+    assert_eq!(full.get("previous_response_id"), None);
+    assert_eq!(
+        full["input"],
+        serde_json::to_value(&projected.input).unwrap()
+    );
+    let repeated = connection.get(/*index*/ 2).unwrap().body_json();
+    assert_eq!(repeated["previous_response_id"], "resp-2");
+    assert_eq!(repeated["input"], json!([]));
+    server.shutdown().await;
+}
